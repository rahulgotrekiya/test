import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';

class CalculatorScreen extends StatefulWidget {
  const CalculatorScreen({super.key});

  @override
  State<CalculatorScreen> createState() => _State();

}

class _State extends State<CalculatorScreen> {
  TextEditingController firstNumController = TextEditingController();
  TextEditingController secondNumController = TextEditingController();
  TextEditingController answerController = TextEditingController();

  @override
  void dispose() {
    super.dispose();
    firstNumController.dispose();
    secondNumController.dispose();
    answerController.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        leading: Icon(
          Icons.calculate_rounded,
          color: Colors.teal,  
        ),
        title: Text("Simple Calculator"),
      ),

      body: Column(

        children: [
          // First Input
          Container(
            padding: EdgeInsets.all(12),
            width: 200,
            height: 120,
            child: TextField(
              keyboardType: TextInputType.number,
              textAlign: TextAlign.center,
              maxLines: 1,
              controller: firstNumController,
              style: TextStyle(
                fontFamily: "Verdana",
                fontSize: 20,
                fontWeight: FontWeight.bold,
              ),
            ),
          ),

          // Second Input
          Container(
            padding: EdgeInsets.all(12),
            width: 200,
            height: 120,
            child: TextField(
              keyboardType: TextInputType.number,
              textAlign: TextAlign.center,
              maxLines: 1,
              controller: secondNumController,
              style: TextStyle(
                  fontFamily: "Verdana",
                  fontSize: 20,
                  fontWeight: FontWeight.bold
              ),
            ),
          ),

          // Answer Screen
          Center(
            child: SizedBox(
              width: 350,
              child: TextField(
                controller: answerController,
                textAlign: TextAlign.center,
                decoration: InputDecoration(
                  hintText: "Answer will be displayed here",
                  hintStyle: TextStyle(
                    color: Colors.teal,
                    fontSize: 24,
                    fontFamily: "Verdana",
                    fontWeight: FontWeight.bold,
                  )
                ),
                style: TextStyle(
                  color: Colors.teal,
                  fontSize: 22,
                  fontFamily: "Verdana",
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
          ),

          SizedBox(
            height: 30,
          ),

          // Calculations Options
          Padding(
            padding: const EdgeInsets.all(12.0),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.center,
              spacing: 5,
              children: [
                ElevatedButton(
                    onPressed: (){
                      setState(() {
                        answerController.text = add(double.parse(firstNumController.text),double.parse(secondNumController.text)).toString();
                      });
                    },
                    child: Text("+",
                      style: TextStyle(
                          color: Colors.white
                      ),
                    ),
                    style: ElevatedButton.styleFrom(
                      backgroundColor: Colors.teal
                    )
                ),

                ElevatedButton(
                    onPressed: (){
                      setState(() {
                        answerController.text = subtract(double.parse(firstNumController.text),double.parse(secondNumController.text)).toString();
                      });
                    },
                    child: Text("-",
                      style: TextStyle(
                          color: Colors.white
                      ),
                    ),
                    style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.teal
                    )
                ),

                ElevatedButton(
                    onPressed: (){
                      setState(() {
                        answerController.text = multiply(double.parse(firstNumController.text),double.parse(secondNumController.text)).toString();
                      });
                    },
                    child: Text("*",
                    style: TextStyle(
                        color: Colors.white
                      ),
                    ),
                    style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.teal
                    )
                ),

                ElevatedButton(
                    onPressed: (){
                      setState(() {
                        answerController.text = divide(double.parse(firstNumController.text),double.parse(secondNumController.text)).toString();
                      });
                    },
                    child: Text("/",
                      style: TextStyle(
                          color: Colors.white
                      ),
                    ),
                    style: ElevatedButton.styleFrom(
                        backgroundColor: Colors.teal
                    )
                ),
              ],
            ),
          ),

        ],

      ),
    );
  }

  double add(double firstNumber,double secondNumber) => firstNumber + secondNumber;
  double subtract(double firstNumber,double secondNumber) => firstNumber - secondNumber;
  double multiply(double firstNumber,double secondNumber) => firstNumber * secondNumber;
  double divide(double firstNumber,double secondNumber){
    if(secondNumber==0){
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Cannot Devide By ZERO')),
      );
      throw Exception("Cannot Devide By ZERO");
    }else{
      return firstNumber/secondNumber;
    }
  }
}



























